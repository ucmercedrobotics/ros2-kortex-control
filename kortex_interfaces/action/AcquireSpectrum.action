# Goal: Request spectrum acquisition
int32 integration_time 1       # Integration time (default 1, uses auto-exposure)
int32 frame_avg_num 20         # Number of frames to average for noise reduction
bool enable_auto_exposure true # Enable auto-exposure adjustment
---
# Result: Final spectrum data
bool success
string message
uint16[] wavelengths           # Wavelength values in nm
float64[] spectrum             # Intensity values
float64 x                      # CIE X color value
float64 y                      # CIE Y color value  
float64 z                      # CIE Z color value
int32 integration_time_used    # Actual integration time used
bool was_saturated             # True if sensor was saturated
---
# Feedback: Status updates during acquisition
string status                  # Current status message
float32 progress               # Progress 0.0 to 1.0

